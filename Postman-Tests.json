    {
      "name": "Scénario 3 - Cours Enrichis (GET /cours/enrichis)",
      "item": [
        {
          "name": "3.1 GET /cours/enrichis (nominal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Réponse est un tableau JSON', function () {",
                  "    pm.response.to.be.json;",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Chaque cours enrichi contient les infos étudiant', function () {",
                  "    var json = pm.response.json();",
                  "    if (json.length > 0) {",
                  "        var cours = json[0];",
                  "        pm.expect(cours).to.have.property('id');",
                  "        pm.expect(cours).to.have.property('titre');",
                  "        // L'objet étudiant doit être imbriqué",
                  "        pm.expect(cours).to.have.property('etudiant');",
                  "        pm.expect(cours.etudiant).to.have.property('nom');",
                  "        pm.expect(cours.etudiant).to.have.property('prenom');",
                  "    }",
                  "});",
                  "",
                  "pm.test('Temps de réponse < 2000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_cours}}/cours/enrichis",
              "host": [
                "{{base_cours}}"
              ],
              "path": [
                "cours",
                "enrichis"
              ]
            },
            "description": "Récupère les cours enrichis avec les données étudiant. ServiceCours appelle ServiceEtudiants en interne. Attend HTTP 200 avec tableau d'objets contenant cours + étudiant imbriqué."
          },
          "response": []
        },
        {
          "name": "3.2 GET /cours/enrichis - vérifier un cours spécifique",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Le cours créé est présent dans la liste enrichie', function () {",
                  "    var json = pm.response.json();",
                  "    var coursId = pm.collectionVariables.get('cours_id');",
                  "    var found = json.find(function(c) {",
                  "        return String(c.id) === String(coursId);",
                  "    });",
                  "    pm.expect(found).to.not.be.undefined;",
                  "    pm.expect(found.etudiant).to.not.be.null;",
                  "    pm.expect(found.etudiant.nom).to.eql('Laayadi');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_cours}}/cours/enrichis",
              "host": [
                "{{base_cours}}"
              ],
              "path": [
                "cours",
                "enrichis"
              ]
            },
            "description": "Vérifie que le cours créé au scénario 2 apparaît bien dans la liste enrichie avec les bonnes données étudiant."
          },
          "response": []
        }
      ],
      "description": "Appel de l'endpoint /cours/enrichis qui agrège les données cours + étudiant via appel inter-services."
    },
    {
      "name": "Scénario 4 - Suppression étudiant et impact sur /cours/enrichis",
      "item": [
        {
          "name": "4.1 Supprimer l'étudiant (DELETE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 ou 204 (suppression réussie)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "",
                  "console.log('Étudiant supprimé, ID:', pm.collectionVariables.get('etudiant_id'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_etudiants}}/etudiants/{{etudiant_id}}",
              "host": [
                "{{base_etudiants}}"
              ],
              "path": [
                "etudiants",
                "{{etudiant_id}}"
              ]
            },
            "description": "Supprime l'étudiant créé au scénario 1. Attend HTTP 200 ou 204."
          },
          "response": []
        },
        {
          "name": "4.2 Vérifier que l'étudiant est supprimé (GET 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404 - étudiant bien supprimé', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Message d\\'erreur lisible', function () {",
                  "    pm.response.to.be.json;",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('message');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_etudiants}}/etudiants/{{etudiant_id}}",
              "host": [
                "{{base_etudiants}}"
              ],
              "path": [
                "etudiants",
                "{{etudiant_id}}"
              ]
            },
            "description": "Confirme que l'étudiant supprimé n'est plus accessible. Attend HTTP 404."
          },
          "response": []
        },
        {
          "name": "4.3 GET /cours/enrichis après suppression étudiant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK (service cours toujours opérationnel)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Réponse JSON valide', function () {",
                  "    pm.response.to.be.json;",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Le cours orphelin a etudiant null ou message d\\'erreur', function () {",
                  "    var json = pm.response.json();",
                  "    var coursId = pm.collectionVariables.get('cours_id');",
                  "    var coursOrphelin = json.find(function(c) {",
                  "        return String(c.id) === String(coursId);",
                  "    });",
                  "    if (coursOrphelin) {",
                  "        // L'étudiant doit être null ou contenir un message d'erreur",
                  "        var etudiant = coursOrphelin.etudiant;",
                  "        var isNullOrError = (etudiant === null) || (etudiant === undefined) ||",
                  "            (typeof etudiant === 'object' && etudiant.hasOwnProperty('erreur'));",
                  "        pm.expect(isNullOrError).to.be.true;",
                  "        console.log('Comportement étudiant supprimé:', JSON.stringify(etudiant));",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_cours}}/cours/enrichis",
              "host": [
                "{{base_cours}}"
              ],
              "path": [
                "cours",
                "enrichis"
              ]
            },
            "description": "Vérifie le comportement de /cours/enrichis après suppression de l'étudiant. Le cours orphelin doit avoir etudiant=null ou un message d'erreur géré."
          },
          "response": []
        }
      ],
      "description": "Supprime l'étudiant créé et vérifie l'impact sur l'endpoint /cours/enrichis."
    },
    {
      "name": "Scénario 5 - Simulation panne ServiceEtudiants",
      "item": [
        {
          "name": "5.1 [PRÉ-PANNE] Vérifier ServiceEtudiants UP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ServiceEtudiants est UP (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "console.log('ServiceEtudiants opérationnel. Arrêtez-le maintenant puis exécutez 5.2 et 5.3.');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_etudiants}}/etudiants",
              "host": [
                "{{base_etudiants}}"
              ],
              "path": [
                "etudiants"
              ]
            },
            "description": "Vérifie que ServiceEtudiants est bien UP avant de simuler la panne. Exécuter AVANT d'arrêter le service."
          },
          "response": []
        },
        {
          "name": "5.2 [PANNE] Appel direct ServiceEtudiants (connexion refusée)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Quand le service est arrêté, on attend une erreur réseau ou 503",
                  "pm.test('Service indisponible (erreur réseau ou 5xx)', function () {",
                  "    var code = pm.response.code;",
                  "    // Connexion refusée = code 0 ou erreur réseau, ou 503/502",
                  "    var isUnavailable = (code === 0) || (code >= 500 && code <= 599);",
                  "    pm.expect(isUnavailable).to.be.true;",
                  "});",
                  "",
                  "console.log('Code reçu:', pm.response.code, '- Status:', pm.response.status);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_etudiants}}/etudiants",
              "host": [
                "{{base_etudiants}}"
              ],
              "path": [
                "etudiants"
              ]
            },
            "description": "Appel direct à ServiceEtudiants alors qu'il est arrêté. Attend une erreur réseau (connexion refusée) ou HTTP 5xx."
          },
          "response": []
        },
        {
          "name": "5.3 [PANNE] GET /cours/enrichis avec ServiceEtudiants DOWN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Comportement attendu : ServiceCours doit gérer la panne gracieusement",
                  "pm.test('ServiceCours répond (pas de crash total)', function () {",
                  "    // On accepte 200 (fallback), 503 (service unavailable) ou 500",
                  "    var code = pm.response.code;",
                  "    pm.expect(code).to.be.oneOf([200, 500, 503]);",
                  "});",
                  "",
                  "pm.test('Réponse JSON avec message d\\'erreur lisible', function () {",
                  "    pm.response.to.be.json;",
                  "    var json = pm.response.json();",
                  "    // Soit un tableau avec etudiant=null (fallback), soit un objet erreur",
                  "    var isArray = Array.isArray(json);",
                  "    var isErrorObj = typeof json === 'object' && json.hasOwnProperty('message');",
                  "    pm.expect(isArray || isErrorObj).to.be.true;",
                  "    if (isErrorObj) {",
                  "        pm.expect(json.message).to.be.a('string');",
                  "        pm.expect(json.message.length).to.be.greaterThan(0);",
                  "        console.log('Message erreur:', json.message);",
                  "    }",
                  "    if (isArray) {",
                  "        console.log('Fallback: tableau retourné avec', json.length, 'éléments');",
