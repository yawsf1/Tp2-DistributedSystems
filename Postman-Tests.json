    {
      "name": "Scénario 1 - Étudiants (POST + GET)",
      "item": [
        {
          "name": "1.1 Créer un étudiant (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Vérification code HTTP 201",
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// Vérification structure JSON",
                  "pm.test('Réponse JSON valide', function () {",
                  "    pm.response.to.be.json;",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('nom');",
                  "    pm.expect(json).to.have.property('prenom');",
                  "    pm.expect(json).to.have.property('email');",
                  "});",
                  "",
                  "// Sauvegarder l'ID pour les requêtes suivantes",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('etudiant_id', json.id);",
                  "console.log('Étudiant créé avec ID:', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Laayadi\",\n  \"prenom\": \"Youssef\",\n  \"email\": \"youssef.laayadi@etudiant.ma\"\n}"
            },
